# Gemini configuration
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash
SERPER_API_KEY=

# MongoDB for AI chat backend
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Cluster
MONGODB_DB_NAME=remiro_ai_chat

# Must match Remiro-land_back JWT secret for token validation
JWT_SECRET=replace_with_same_secret_as_remiro_land_back

# Frontend origin(s) allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# Optional: kept for Streamlit UI compatibility (not used by FastAPI chat server)
SUPABASE_URL=
SUPABASE_KEY=
